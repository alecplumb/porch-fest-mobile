<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.PorchFest" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Shown by the system while the app starts: the icon's mark in a gold disc on beige. -->
    <style name="Theme.PorchFest.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/brand_beige</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/brand_gold</item>
        <item name="postSplashScreenTheme">@style/Theme.PorchFest</item>
    </style>
</resources>
